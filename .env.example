# SIH26165 Backend Environment Configuration Example
# Copy to .env for local overrides (Do not commit secrets to version control)

# Database Connection (PostgreSQL for production; defaults to SQLite for local development if unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sif_db

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8501

# Environment mode (development / production / testing)
ENVIRONMENT=development

# JWT Authentication Secret Key (Required for production deployments)
JWT_SECRET_KEY=replace-with-a-secure-random-32-char-string-in-production

